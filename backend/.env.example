# Database access is needed for user creation and career analysis.
# /health is a liveness check and does not require the database.
# Set either CAREER_DB_URL or CAREER_DB_PASSWORD with the optional components below.
CAREER_DB_URL=
CAREER_DB_PASSWORD=
CAREER_DB_HOST=localhost
CAREER_DB_PORT=5433
CAREER_DB_NAME=career_intelligence
CAREER_DB_USER=postgres

# Required for CV extraction and LLM-assisted analysis; never commit a real key.
GEMINI_API_KEY=
CAREER_LLM_MODEL=gemini-2.5-flash

# Development prototype only. This acknowledges that API routes have no auth.
# Keep Uvicorn bound to 127.0.0.1 and do not enable remote clients.
CAREER_API_ACKNOWLEDGE_NO_AUTH=true
# Optional upload/workflow settings; defaults are enforced by the application.
# CAREER_API_MAX_UPLOAD_BYTES=10485760
# CAREER_API_MAX_PDF_PAGES=50
# CAREER_API_MAX_REVISIONS=2

# Per-analysis section-19 audit logs. Defaults to backend/artifacts/analysis_logs
# (git-ignored). Set a different private directory if needed.
# CAREER_ANALYSIS_LOG_DIR=
